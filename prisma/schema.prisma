generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LostItem {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String   @default("")
  location    String
  date        DateTime @db.Date
  phone       String
  reward      String   @default("")
  images      String[]
  userId      String
  userName    String   @default("")
  userEmail   String   @default("")
  userPhoto   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  status     String    @default("open")
  returnedAt DateTime?
  latitude   Float?
  longitude  Float?
  
  @@index([date])
    @@index([status])
  @@index([userId])
  @@map("lost_items")
}

model FoundItem {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String   @default("")
  location    String
  date        DateTime @db.Date
  phone       String
  reward      String   @default("")
  images      String[]
  userId      String
  userName    String   @default("")
  userEmail   String   @default("")
  userPhoto   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  status     String    @default("open")
  returnedAt DateTime?
  latitude   Float?
  longitude  Float?

  @@index([date])
    @@index([status])
  @@index([userId])
  @@map("found_items")
}
model Claim {
  id           String   @id @default(cuid())
  itemId       String
  claimerId    String
  claimerName  String
  claimerEmail String
  claimerPhoto String   @default("")
  proof        String
  phone        String
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([itemId, claimerId])
  @@index([itemId])
  @@index([claimerId])
  @@map("claims")
}
model Conversation {
  id            String    @id @default(cuid())
  itemType      String
  itemId        String
  itemName      String
  ownerId       String
  ownerName     String    @default("")
  ownerPhoto    String    @default("")
  starterId     String
  starterName   String    @default("")
  starterPhoto  String    @default("")
  lastMessage   String    @default("")
  lastSenderId  String    @default("")
  lastMessageAt DateTime  @default(now())
  ownerReadAt   DateTime  @default(now())
  starterReadAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  messages      Message[]

  @@unique([itemType, itemId, starterId])
  @@index([ownerId])
  @@index([starterId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  text           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}
model SavedItem {
  id        String   @id @default(cuid())
  userId    String
  itemType  String
  itemId    String
  createdAt DateTime @default(now())

  @@unique([userId, itemType, itemId])
  @@index([userId])
  @@map("saved_items")
}

model Report {
  id            String   @id @default(cuid())
  itemType      String
  itemId        String
  itemName      String
  reporterId    String
  reporterName  String   @default("")
  reporterEmail String   @default("")
  reason        String
  details       String   @default("")
  status        String   @default("open")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([itemType, itemId, reporterId])
  @@index([status])
  @@index([itemType, itemId])
  @@map("reports")
}
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String   @default("")
  link      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
  @@map("notifications")
}